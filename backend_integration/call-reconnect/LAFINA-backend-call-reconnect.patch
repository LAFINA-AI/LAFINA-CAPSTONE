+# One call may reconnect this many times on linked sessions; after that a
+# new session counts as a new call.
+MAX_LINKED_SESSIONS_PER_CALL = 8
+
+
+async def _linked_call(
+    db: AsyncSession, account: Account, resume_of: uuid.UUID, now: datetime
+) -> tuple[VoiceSession, VoiceSession]:
+    """The dropped session and its call's first session, or a 404/409.
+
+    Only the student's own session, only while the call's time is not used
+    up, and only a bounded number of times per call. The app then starts a
+    new, separately counted call instead.
+    """
+    previous = await _owned_session(db, account, resume_of)
+    root = previous
+    if previous.call_root_id is not None:
+        await set_transaction_rls_user(db, account.id)
+        root = await db.get(VoiceSession, previous.call_root_id) or previous
+    if root.owner_id != account.id:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND, detail="Voice conversation not found."
+        )
+    # The grace covers connecting, not talking: a link ends where the call would.
+    grace = timedelta(seconds=settings.VOICE_CONVERSATION_START_GRACE_SECONDS)
+    if _utc(root.expires_at) - grace <= now:
+        raise HTTPException(
+            status_code=status.HTTP_409_CONFLICT,
+            detail="That call already used its time. Start a new call.",
+        )
+    await set_transaction_rls_user(db, account.id)
+    count = await db.scalar(
+        select(func.count()).select_from(VoiceSession).where(VoiceSession.call_root_id == root.id)
+    )
+    if (count or 0) >= MAX_LINKED_SESSIONS_PER_CALL:
+        raise HTTPException(
+            status_code=status.HTTP_409_CONFLICT,
+            detail="That call reconnected too many times. Start a new call.",
+        )
+    return previous, root
+
+
