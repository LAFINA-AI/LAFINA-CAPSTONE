+"""016 Voice call reconnect: link a reconnected session to its call
+
+Revision ID: 016_voice_call_reconnect
+Revises: 015_audit_hardening
+Create Date: 2026-11-26
+
+When a live call drops (network or server), the app starts a new ElevenLabs
+conversation and asks for a session linked to the dropped one (ADR-046).
+`resumed_from_id` names the dropped session and `call_root_id` the call's
+first one. A linked session ends when the call would have, shares its turn
+budget, and is not counted as a new call. Both columns are nullable, so
+existing rows and older apps are unaffected. The table's RLS policy already
+covers the new columns.
+"""
+
+from alembic import op
+
+revision = "016_voice_call_reconnect"
+down_revision = "015_audit_hardening"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.execute(
+        "ALTER TABLE voice_sessions ADD COLUMN IF NOT EXISTS resumed_from_id UUID "
+        "REFERENCES voice_sessions(id) ON DELETE SET NULL"
+    )
+    op.execute(
+        "ALTER TABLE voice_sessions ADD COLUMN IF NOT EXISTS call_root_id UUID "
+        "REFERENCES voice_sessions(id) ON DELETE SET NULL"
+    )
+    op.execute(
+        "CREATE INDEX IF NOT EXISTS ix_voice_sessions_call_root_id ON voice_sessions (call_root_id)"
+    )
+
+
+def downgrade() -> None:
+    op.execute("DROP INDEX IF EXISTS ix_voice_sessions_call_root_id")
+    op.execute("ALTER TABLE voice_sessions DROP COLUMN IF EXISTS call_root_id")
+    op.execute("ALTER TABLE voice_sessions DROP COLUMN IF EXISTS resumed_from_id")
