+"""ADR-046: a dropped call reconnects on a linked session and keeps its memory."""
+
+import json
+import uuid
+from datetime import UTC, datetime, timedelta
+
+from sqlalchemy import select
+
+from app.api.v1 import voice
+from app.models.ai_usage import AIUsage
+from app.models.voice_session import VoiceSession
+from app.services.voice_conversation import (
+    call_mode_prompt,
+    call_recap_turns,
+    with_call_recap,
+)
+from tests import test_voice_conversation as voice_tests
+from tests.conftest import TestingSessionLocal
+from tests.test_online_voices import signed_in
+from tests.test_voice_conversation import (
+    LLM_PATH,
+    deepseek_calls,
+    llm_headers,
+    session_row,
+    start,
+    turn_body,
+)
+
+# The shared synthetic-provider fixture.
+world = voice_tests.world
+
+
+async def session_usage_count() -> int:
+    async with TestingSessionLocal() as db:
+        rows = await db.execute(select(AIUsage).where(AIUsage.request_type == voice.SESSION_USAGE))
+        return len(rows.scalars().all())
+
+
+async def test_capabilities_offer_resume(async_client, world):
+    headers = await signed_in(async_client)
+    body = (await async_client.get("/v1/ai/voice/capabilities", headers=headers)).json()
+    assert body["resume"] is True
+
+
+async def test_reconnect_is_linked_and_not_a_new_call(async_client, world, monkeypatch):
+    monkeypatch.setattr(voice.settings, "VOICE_CONVERSATION_SESSIONS_PER_DAY", 1)
+    headers = await signed_in(async_client)
+    first = (await start(async_client, headers)).json()
+    await async_client.post(LLM_PATH, headers=llm_headers(first["grant"]), json=turn_body("hello"))
+    # The daily limit (1) is used up, but a reconnect is the same call.
+    second = await start(async_client, headers, resumeOf=first["sessionId"])
+    assert second.status_code == 200, second.text
+    linked = await session_row(second.json()["sessionId"])
+    assert str(linked.resumed_from_id) == first["sessionId"]
+    assert str(linked.call_root_id) == first["sessionId"]
+    assert linked.turns == 1  # the call's turn budget carries over
+    assert await session_usage_count() == 1
+    # The dropped session is closed; the new one answers.
+    assert (await session_row(first["sessionId"])).status == "ended"
+    fresh = await async_client.post(
+        LLM_PATH, headers=llm_headers(second.json()["grant"], "conv_2"), json=turn_body("hi")
+    )
+    assert fresh.status_code == 200
+    # A second reconnect links to the call's first session.
+    third = (await start(async_client, headers, resumeOf=second.json()["sessionId"])).json()
+    assert str((await session_row(third["sessionId"])).call_root_id) == first["sessionId"]
+    # A new call is still refused by the daily limit.
+    assert (await start(async_client, headers)).status_code == 429
+
+
+async def test_reconnect_never_extends_the_call(async_client, world):
+    headers = await signed_in(async_client)
+    first = (await start(async_client, headers)).json()
+    async with TestingSessionLocal() as db:
+        row = await db.get(VoiceSession, uuid.UUID(first["sessionId"]))
+        # 200 of the call's 300 seconds are gone.
+        row.expires_at = row.expires_at - timedelta(seconds=200)
+        await db.commit()
+        root_expiry = row.expires_at
+    second = (await start(async_client, headers, resumeOf=first["sessionId"])).json()
+    assert 90 <= second["maxDurationSeconds"] <= 100
+    linked = await session_row(second["sessionId"])
+    expiry = (
+        linked.expires_at if linked.expires_at.tzinfo else linked.expires_at.replace(tzinfo=UTC)
+    )
+    root = root_expiry if root_expiry.tzinfo else root_expiry.replace(tzinfo=UTC)
+    assert expiry == root
+
+
+async def test_a_used_up_call_is_not_linked(async_client, world):
+    headers = await signed_in(async_client)
+    first = (await start(async_client, headers)).json()
+    async with TestingSessionLocal() as db:
+        row = await db.get(VoiceSession, uuid.UUID(first["sessionId"]))
+        row.expires_at = datetime.now(UTC) + timedelta(
+            seconds=voice.settings.VOICE_CONVERSATION_START_GRACE_SECONDS - 5
+        )
+        await db.commit()
+    refused = await start(async_client, headers, resumeOf=first["sessionId"])
+    assert refused.status_code == 409
+
+
+async def test_only_your_own_session_can_be_continued(async_client, world):
+    owner = await signed_in(async_client)
+    first = (await start(async_client, owner)).json()
+    registered = await async_client.post(
+        "/v1/auth/register",
+        json={"email": "other@example.org", "password": "SyntheticPassword123!"},
+    )
+    other = {"Authorization": "Bearer " + registered.json()["access_token"]}
+    refused = await start(async_client, other, resumeOf=first["sessionId"])
+    assert refused.status_code == 404
+    unknown = await start(async_client, owner, resumeOf=str(uuid.uuid4()))
+    assert unknown.status_code == 404
+
+
+async def test_reconnects_per_call_are_capped(async_client, world, monkeypatch):
+    monkeypatch.setattr(voice, "MAX_LINKED_SESSIONS_PER_CALL", 2)
+    headers = await signed_in(async_client)
+    last = (await start(async_client, headers)).json()["sessionId"]
+    for _ in range(2):
+        last = (await start(async_client, headers, resumeOf=last)).json()["sessionId"]
+    assert (await start(async_client, headers, resumeOf=last)).status_code == 409
+
+
+async def test_call_recap_and_mode_reach_deepseek(async_client, world):
+    headers = await signed_in(async_client)
+    session = (await start(async_client, headers)).json()
+    body = {
+        **turn_body("and the one after?"),
