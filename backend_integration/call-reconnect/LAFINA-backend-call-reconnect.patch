+++ b/app/services/voice_conversation.py
@@ -113,6 +113,94 @@ def student_context_prompt(extra: object, max_chars: int) -> str | None:
     )
 
 
+CALL_RECAP_FIELD = "call_recap"
+CALL_MODE_FIELD = "call_mode"
+CALL_RECAP_MAX_TURNS = 12
+CALL_RECAP_MAX_TURN_CHARS = 600
+
+# Fixed server text for the app's call mode; anything else is ignored.
+_CALL_MODE_NOTES = {
+    "reconnect": (
+        "This call dropped for a moment and reconnected. The earlier part of this call comes "
+        "first in the conversation. Carry on from where it stopped: do not greet the student "
+        "again, do not restart, and do not repeat an answer they already heard. If your last "
+        "answer was cut off, finish it briefly."
+    ),
+    "resume": (
+        "The student chose to continue this call after it stopped. The earlier part of this call "
+        "comes first in the conversation. Carry on naturally: do not greet them as if it were a "
+        "new call, and do not repeat what they already heard."
+    ),
+}
+
+
+def call_mode_prompt(extra: object) -> str | None:
+    """A fixed note for a reconnected or continued call, or None."""
+    if not isinstance(extra, dict):
+        return None
+    mode = extra.get(CALL_MODE_FIELD)
+    return _CALL_MODE_NOTES.get(mode) if isinstance(mode, str) else None
+
+
+def call_recap_turns(extra: object) -> list[dict[str, str]]:
+    """The earlier turns of a reconnected call, oldest first, or [].
+
+    The phone sends them because ElevenLabs starts a new conversation on a
+    reconnect and forgets the old one. They are the student's own call, so
+    they go in as earlier turns; they are bounded and cleaned like the
+    student summary. The recap starts with the student and ends with LAFINA:
+    an unanswered last question is in the new conversation itself.
+    """
+    if not isinstance(extra, dict):
+        return []
+    raw = extra.get(CALL_RECAP_FIELD)
+    if not isinstance(raw, list):
+        return []
+    turns: list[dict[str, str]] = []
+    for item in raw[-CALL_RECAP_MAX_TURNS:]:
+        if not isinstance(item, dict) or item.get("role") not in ("user", "assistant"):
+            continue
+        text = item.get("text")
+        if not isinstance(text, str):
+            continue
+        text = " ".join(_strip_voice_fences(text).split())[:CALL_RECAP_MAX_TURN_CHARS]
+        if text:
+            turns.append({"role": item["role"], "content": text})
+    while turns and turns[0]["role"] != "user":
+        turns.pop(0)
+    while turns and turns[-1]["role"] != "assistant":
+        turns.pop()
+    return turns
+
+
+def with_call_recap(
+    recap: list[dict[str, str]], turns: list[dict[str, str]], *, max_messages: int, max_chars: int
+) -> list[dict[str, str]]:
+    """Earlier call turns in front of the new conversation's, within the bounds.
+
+    The new conversation's turns always stay whole; the recap fills the room
+    left, newest first. Nothing is added once the new conversation already
+    fills the bounds.
+    """
+    if not recap or not turns:
+        return turns
+    room_messages = max_messages - len(turns)
+    room_chars = max_chars - sum(len(t["content"]) for t in turns)
+    kept: list[dict[str, str]] = []
+    for turn in reversed(recap):
+        if room_messages <= 0 or len(turn["content"]) > room_chars:
+            break
+        kept.append(turn)
+        room_messages -= 1
+        room_chars -= len(turn["content"])
+    kept.reverse()
+    while kept and kept[0]["role"] != "user":
+        kept.pop(0)
+    # The recap ends with LAFINA and the new turns start with the student, so
+    # the roles still alternate.
+    return kept + turns
+
+
 CONTEXTUAL_UPDATE_TOOL = "contextual_update"
 _APP_UPDATE_OPEN = "<app_update>"
 _APP_UPDATE_CLOSE = "</app_update>"
