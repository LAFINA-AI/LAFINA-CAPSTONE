+def _mutation(
+    mutation_id: str,
+    entity_type: str,
+    entity_id: str,
+    payload: dict[str, object],
+    operation: str = "create",
+) -> dict[str, object]:
+    # Chat is last-write-wins: the app never sends a baseVersion for it.
+    return {
+        "mutationId": mutation_id,
+        "entityType": entity_type,
+        "entityId": entity_id,
+        "operation": operation,
+        "clientUpdatedAt": STAMP,
+        "payload": payload,
+    }
+
