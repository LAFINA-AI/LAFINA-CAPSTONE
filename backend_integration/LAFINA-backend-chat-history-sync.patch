+def _message(
+    content: str = "When is my thesis due?",
+    session_id: str = SESSION,
+    sender: str = "user",
+) -> dict[str, object]:
+    return {
+        "session_id": session_id,
+        "sender": sender,
+        "content": content,
+        "created_at": "2026-11-21T02:00:01.000Z",
+    }
