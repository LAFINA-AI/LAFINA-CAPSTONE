+def test_client_tool_schema_adapts_without_weakening_server_contract():
+    from scripts.provision_voice_agent import client_tool_schema
+
+    original = {
+        "type": "object",
+        "additionalProperties": False,
+        "properties": {
+            "items": {
+                "type": "array",
