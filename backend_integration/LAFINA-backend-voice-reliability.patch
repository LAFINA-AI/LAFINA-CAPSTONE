+_VOICE_HANDBOOK_PATTERN = re.compile(
+    r"\b(?:handbook|ustp|university|college|campus|policy|policies|rule|rules|regulation|regulations|"
+    r"dress\s*code|attire|uniform|id\s*card|attendance|absent|absence|tardy|late\s+policy|"
+    r"grade|grades|grading|gwa|gpa|latin\s*honor|scholarship|enroll|enrollment|drop|dropping|"
