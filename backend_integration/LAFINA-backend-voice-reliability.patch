+    r"curriculum|prerequisite|academic\s+standing|retention|graduation|dean|registrar|osa|library|"
+    r"clearance|exam\s+permit|citation)\b",
+    re.I,
+)
+
+
+def _should_use_voice_handbook(turns: list[dict[str, object]]) -> bool:
+    for turn in reversed(turns):
+        if turn.get("role") == "user":
+            content = turn.get("content")
+            return isinstance(content, str) and bool(_VOICE_HANDBOOK_PATTERN.search(content))
+    return False
+
