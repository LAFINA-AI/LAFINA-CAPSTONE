+def test_voice_style_instruction_uses_first_person_only():
+    from app.services.voice_conversation import VOICE_STYLE_INSTRUCTION
+
+    assert "LAFINA shows" not in VOICE_STYLE_INSTRUCTION
+    assert "first person" in VOICE_STYLE_INSTRUCTION
+
+
+async def test_casual_or_scheduling_turn_skips_handbook_retrieval(async_client, world):
+    calls = []
+
+    class Retriever:
+        configured = True
+
+        async def retrieve(self, query):
+            calls.append(query)
+            return []
+
+    from app.api.v1.ai import get_handbook_retriever
+
+    app.dependency_overrides[get_handbook_retriever] = lambda: Retriever()
+    try:
+        headers = await signed_in(async_client)
+        session = (await start(async_client, headers, useHandbook=True)).json()
+        await async_client.post(
+            LLM_PATH,
+            headers=llm_headers(session["grant"]),
+            json=turn_body("schedule me a meeting"),
+        )
+        assert calls == []
+        await async_client.post(
+            LLM_PATH,
+            headers=llm_headers(session["grant"]),
+            json=turn_body("what is the dress code?"),
+        )
+        assert len(calls) == 1
+    finally:
+        app.dependency_overrides.pop(get_handbook_retriever, None)
+
+
