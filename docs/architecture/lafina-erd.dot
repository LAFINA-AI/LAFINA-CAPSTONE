digraph LAFINA {
graph [rankdir=LR, bgcolor="white", pad=0.5, nodesep=0.5, ranksep=1.4, splines=spline, outputorder=edgesfirst, fontname="Arial", fontsize=22, labelloc=t, labeljust=l];
label="LAFINA — Local database ERD (schema 28)\l36 application tables | all declared columns | Android lafina.db\l\lPK / PK1..n = primary key | FK = declared foreign key | UQ = single-column unique key\lNN = explicit NOT NULL | LR = logical reference | PR = polymorphic reference (neither is an FK)\lSolid crow's-foot = SQL FK (one parent; zero or one / many children). Dashed arrow = logical reference only.\lRepeated user_id LR lines are omitted: each refers to users.id. See the companion schema guide for constraints and polymorphic links.\l";
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=9, color="#66717e", arrowsize=0.8];
subgraph cluster_0 { label="Identity &amp; preferences"; fontsize=18; color="#c8cdd3"; margin=20;
{rank=same; "users";"user_preferences";"active_session";"remember_me";"local_settings";"custom_categories";}
"users" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8b9199"><TR><TD COLSPAN="3" BGCOLOR="#eef0f2"><B>users</B></TD></TR><TR><TD><B>Key</B></TD><TD><B>Column</B></TD><TD><B>SQLite type</B></TD></TR><TR><TD PORT="id_w" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="id_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="username_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">username</TD><TD PORT="username_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="email_w" ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">email</TD><TD PORT="email_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="password_hash_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">password_hash</TD><TD PORT="password_hash_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="role_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">role</TD><TD PORT="role_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="is_new_user_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_new_user</TD><TD PORT="is_new_user_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="time_format_24h_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">time_format_24h</TD><TD PORT="time_format_24h_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="week_starts_monday_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">week_starts_monday</TD><TD PORT="week_starts_monday_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="dark_mode_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">dark_mode</TD><TD PORT="dark_mode_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="cloud_account_id_w" ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">cloud_account_id</TD><TD PORT="cloud_account_id_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="cloud_linked_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">cloud_linked</TD><TD PORT="cloud_linked_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="cloud_linked_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">cloud_linked_at</TD><TD PORT="cloud_linked_at_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="avatar_uri_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">avatar_uri</TD><TD PORT="avatar_uri_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="product_tour_version_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">product_tour_version</TD><TD PORT="product_tour_version_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="created_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="updated_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at_e" ALIGN="LEFT">TEXT NN</TD></TR></TABLE>>];
"user_preferences" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8b9199"><TR><TD COLSPAN="3" BGCOLOR="#eef0f2"><B>user_preferences</B></TD></TR><TR><TD><B>Key</B></TD><TD><B>Column</B></TD><TD><B>SQLite type</B></TD></TR><TR><TD PORT="id_w" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="id_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="user_id_w" ALIGN="LEFT">FK, UQ</TD><TD ALIGN="LEFT">user_id</TD><TD PORT="user_id_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="wake_time_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">wake_time</TD><TD PORT="wake_time_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="sleep_time_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">sleep_time</TD><TD PORT="sleep_time_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="study_peak_hours_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">study_peak_hours</TD><TD PORT="study_peak_hours_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="busiest_day_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">busiest_day</TD><TD PORT="busiest_day_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="reminder_lead_minutes_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">reminder_lead_minutes</TD><TD PORT="reminder_lead_minutes_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="snooze_tendency_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">snooze_tendency</TD><TD PORT="snooze_tendency_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="weekly_class_count_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">weekly_class_count</TD><TD PORT="weekly_class_count_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="longest_class_gap_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">longest_class_gap</TD><TD PORT="longest_class_gap_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="enable_voice_calls_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">enable_voice_calls</TD><TD PORT="enable_voice_calls_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="enable_notifications_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">enable_notifications</TD><TD PORT="enable_notifications_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="daily_digest_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">daily_digest</TD><TD PORT="daily_digest_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="quiet_hours_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">quiet_hours</TD><TD PORT="quiet_hours_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="created_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="updated_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at_e" ALIGN="LEFT">TEXT NN</TD></TR></TABLE>>];
"active_session" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8b9199"><TR><TD COLSPAN="3" BGCOLOR="#eef0f2"><B>active_session</B></TD></TR><TR><TD><B>Key</B></TD><TD><B>Column</B></TD><TD><B>SQLite type</B></TD></TR><TR><TD PORT="user_id_w" ALIGN="LEFT">PK, LR</TD><TD ALIGN="LEFT">user_id</TD><TD PORT="user_id_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="access_token_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">access_token</TD><TD PORT="access_token_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="refresh_token_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">refresh_token</TD><TD PORT="refresh_token_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="pending_cloud_credential_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">pending_cloud_credential</TD><TD PORT="pending_cloud_credential_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="created_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="updated_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at_e" ALIGN="LEFT">TEXT NN</TD></TR></TABLE>>];
"remember_me" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8b9199"><TR><TD COLSPAN="3" BGCOLOR="#eef0f2"><B>remember_me</B></TD></TR><TR><TD><B>Key</B></TD><TD><B>Column</B></TD><TD><B>SQLite type</B></TD></TR><TR><TD PORT="id_w" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="id_e" ALIGN="LEFT">INTEGER</TD></TR><TR><TD PORT="enabled_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">enabled</TD><TD PORT="enabled_e" ALIGN="LEFT">INTEGER NN</TD></TR><TR><TD PORT="email_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">email</TD><TD PORT="email_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="password_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">password</TD><TD PORT="password_e" ALIGN="LEFT">TEXT</TD></TR><TR><TD PORT="created_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="updated_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at_e" ALIGN="LEFT">TEXT NN</TD></TR></TABLE>>];
"local_settings" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8b9199"><TR><TD COLSPAN="3" BGCOLOR="#eef0f2"><B>local_settings</B></TD></TR><TR><TD><B>Key</B></TD><TD><B>Column</B></TD><TD><B>SQLite type</B></TD></TR><TR><TD PORT="user_id_w" ALIGN="LEFT">PK1, LR</TD><TD ALIGN="LEFT">user_id</TD><TD PORT="user_id_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="key_w" ALIGN="LEFT">PK2</TD><TD ALIGN="LEFT">key</TD><TD PORT="key_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="value_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">value</TD><TD PORT="value_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="updated_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at_e" ALIGN="LEFT">TEXT NN</TD></TR></TABLE>>];
"custom_categories" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8b9199"><TR><TD COLSPAN="3" BGCOLOR="#eef0f2"><B>custom_categories</B></TD></TR><TR><TD><B>Key</B></TD><TD><B>Column</B></TD><TD><B>SQLite type</B></TD></TR><TR><TD PORT="id_w" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="id_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="user_id_w" ALIGN="LEFT">LR</TD><TD ALIGN="LEFT">user_id</TD><TD PORT="user_id_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="name_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD><TD PORT="name_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="color_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">color</TD><TD PORT="color_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="created_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD PORT="created_at_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="updated_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="updated_at_e" ALIGN="LEFT">TEXT NN</TD></TR><TR><TD PORT="deleted_at_w" ALIGN="LEFT"> </TD><TD ALIGN="LEFT">deleted_at</TD><TD PORT="deleted_at_e" ALIGN="LEFT">TEXT</TD></TR></TABLE>>];
"custom_categories" -> "local_settings" -> "remember_me" -> "active_session" -> "user_preferences" -> "users" [style=invis, weight=100];
}
subgraph cluster_1 { label="Personal planner"; fontsize=18; color="#c8cdd3"; margin=20;
{rank=same; "tasks";"events";"time_blocks";"notes";"reminders";"event_time_local";}
