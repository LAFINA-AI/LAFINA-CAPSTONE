}
"users" -> "tasks" -> "chat_sessions" -> "reminder_delivery_jobs" -> "sync_outbox" -> "assistant_operation_receipts" [style=invis, weight=100];
"chat_sessions":id_e:e -> "messages":session_id_w:w [constraint=false, color="#20252b", penwidth=1.5, dir=both, arrowtail=teetee, arrowhead=crowodot];
"users":id_e:e -> "recorded_meetings":user_id_w:w [constraint=false, color="#20252b", penwidth=1.5, dir=both, arrowtail=teetee, arrowhead=crowodot];
"users":id_e:e -> "user_preferences":user_id_w:w [constraint=false, color="#20252b", penwidth=1.5, dir=both, arrowtail=teetee, arrowhead=teeodot];
"notes_search_index":note_id_w:w -> "notes":id_e:e [constraint=false, style=dashed, color="#8d949e", arrowhead=vee];
"event_time_local":event_id_w:w -> "events":id_e:e [constraint=false, style=dashed, color="#8d949e", arrowhead=vee];
"reminder_delivery_jobs":reminder_id_w:w -> "reminders":id_e:e [constraint=false, style=dashed, color="#8d949e", arrowhead=vee];
"reminder_delivery_events":reminder_id_w:w -> "reminders":id_e:e [constraint=false, style=dashed, color="#8d949e", arrowhead=vee];
"reminder_delivery_styles":reminder_id_w:w -> "reminders":id_e:e [constraint=false, style=dashed, color="#8d949e", arrowhead=vee];
"job_queue_items":reminder_id_w:w -> "reminders":id_e:e [constraint=false, style=dashed, color="#8d949e", arrowhead=vee];
"alarms":source_reminder_id_w:w -> "reminders":id_e:e [constraint=false, style=dashed, color="#8d949e", arrowhead=vee];
"chat_memories":session_id_w:w -> "chat_sessions":id_e:e [constraint=false, style=dashed, color="#8d949e", arrowhead=vee];
"chat_legacy_quarantine":session_id_w:w -> "chat_sessions":id_e:e [constraint=false, style=dashed, color="#8d949e", arrowhead=vee];
"handbook_chunks_fts" -> "handbook_chunks" [constraint=false, style=dotted, arrowhead=vee, color="#8d949e"];
}
