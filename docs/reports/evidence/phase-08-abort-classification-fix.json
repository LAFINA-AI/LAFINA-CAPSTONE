    "stopDecisionBefore": "Every reproduced case already stopped; the defect was the stated reason, not the stop decision."
  },
  "fix": {
    "summary": "Pacing only from explicit evidence (sourceTransport.lateAbort is True, or injectionFailureReason SYNTHETIC_REALTIME_LATE/SYNTHETIC_REALTIME_DRIFT); other source/RPC failures flag SOURCE_RPC_FAILURE; an ABORT nothing explains flags GATE_ABORT_UNEXPLAINED. Every flag outside CONTINUE still stops the cohort.",
    "precedence": [
      "PRE_RECORDING_UI_FAILURE",
      "PRODUCER_PACING_ABORT",
      "SOURCE_RPC_FAILURE",
      "PRIVACY_GUARD",
      "GATE_ABORT_UNEXPLAINED"
    ],
    "precedenceRule": "Flags follow pipeline order; all applicable flags are kept and the first is the primary reason. PRODUCER_PACING_ABORT and SOURCE_RPC_FAILURE are exclusive (pacing explains the source abort). GATE_ABORT_UNEXPLAINED is added only when no other flag applies.",
    "continueSetUnchanged": true,
    "continueSet": [
      "COMPLETED_RECOGNITION_MISMATCH",
      "NO_AUDIO_SIGNAL",
      "PASS"
    ],
    "notChanged": [
      "scripts/phase08-emulator-audio.mjs (sender)",
      "parent and native gate",
      "timing limits/pacing",
      "grammar/models/confirmation rules",
      "any trial result"
    ]
  },
